:root {
	--font-sans: Inter, system-ui, sans-serif;

	--surface: #0c0e12;
	--surface-dim: #0c0e12;
	--surface-container: #171a1f;
	--surface-container-high: #1d2025;
	--surface-container-highest: #23262c;
	--surface-variant: #23262c;

	--on-surface: #f6f6fc;
	--on-surface-dim: #aaabb0;

	--primary: #81ecff;
	--primary-dim: #00d4ec;
	--on-primary: #005762;

	--secondary: #45a3f7;
	--tertiary: #ad9fff;

	--outline: #74757a;

	--danger: #ef4444;
	--on-surface-inverse: #000000;

	--shadow-none: 0 0;
	--shadow-fab:
		0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -2px rgba(0, 0, 0, 0.1);
	--shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
	--shadow-focus: 0 0 0 1px rgba(129, 236, 255, 0.4);

	--overlay-white-3: rgba(255, 255, 255, 0.03);
	--overlay-white-5: rgba(255, 255, 255, 0.05);
	--overlay-white-10: rgba(255, 255, 255, 0.1);
	--overlay-white-15: rgba(255, 255, 255, 0.15);
	--overlay-white-20: rgba(255, 255, 255, 0.2);
	--overlay-white-40: rgba(255, 255, 255, 0.4);
	--overlay-white-50: rgba(255, 255, 255, 0.5);
	--overlay-white-60: rgba(255, 255, 255, 0.6);

	--overlay-black-5: rgba(0, 0, 0, 0.05);
	--overlay-black-10: rgba(0, 0, 0, 0.1);
	--overlay-black-70: rgba(0, 0, 0, 0.7);

	--primary-alpha: rgba(129, 236, 255, 0.4);
	--danger-alpha: rgba(239, 68, 68, 0.1);

	--surface-alpha: rgba(12, 14, 18, 0.6);
	--surface-variant-alpha: rgba(35, 38, 44, 0.4);
	--surface-container-alpha: rgba(23, 26, 31, 0.5);
}
